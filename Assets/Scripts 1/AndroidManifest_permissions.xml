<!--
    Android Manifest Permissions for Wallet Export/Import
    ====================================================
    
    Add these permissions inside the <manifest> tag in your Unity project's 
    AndroidManifest.xml file (Plugins/Android/AndroidManifest.xml).
    
    If you don't have a custom AndroidManifest.xml yet:
    1. Go to Unity → Edit → Project Settings → Player → Publishing Settings
    2. Check "Custom Main Manifest"
    3. Unity will create: Assets/Plugins/Android/AndroidManifest.xml
    4. Add the permissions listed below inside the <manifest> tag
-->

<!-- ==================== PERMISSIONS ==================== -->

<!-- Required for Android 9 and below: Read/Write to external storage (Downloads folder) -->
<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

<!-- Required for Android 11+ (API 30+): Broad file access -->
<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

<!-- ==================== APPLICATION TAG ==================== -->
<!--
    Inside your <application> tag, add these attributes for Android 10 compatibility:
    
    android:requestLegacyExternalStorage="true"
    
    Example:
    <application
        android:requestLegacyExternalStorage="true"
        ... other attributes ...>
    </application>
-->


<!-- ==================== FULL EXAMPLE ==================== -->
